{
  "name": "@ansospace/eslint-config",
  "version": "0.0.1",
  "description": "Shared ESLint configuration for AnsoSpace projects with TypeScript, SonarJS, React, Next.js, and Node.js support",
  "type": "module",
  "main": "./base.mjs",
  "exports": {
    "./base": "./base.mjs",
    "./next-js": "./next.mjs",
    "./react": "./react.mjs",
    "./node": "./node.mjs",
    "./turbo": "./turbo.mjs"
  },
  "files": [
    "base.mjs",
    "next.mjs",
    "react.mjs",
    "node.mjs",
    "turbo.mjs",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "sonarjs",
    "react",
    "nextjs",
    "nodejs",
    "express"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ansopedia/ansospace"
  },
  "bugs": {
    "url": "https://github.com/ansopedia/ansospace/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "peerDependencies": {
    "eslint": "^9.39.1",
    "eslint-plugin-sonarjs": "3.0.5",
    "eslint-config-prettier": "10.1.8",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "eslint-plugin-turbo": "2.6.3",
    "eslint-config-next": "16.0.7",
    "@next/eslint-plugin-next": "16.0.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
