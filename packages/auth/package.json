{
  "name": "@ansospace/auth",
  "version": "0.0.1",
  "description": "Centralized authentication package for the AnsoSpace platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/server.ts --format esm --dts",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "dependencies": {
    "@ansospace/types": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "react-hook-form": "^7.65.0"
  },
  "optionalDependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0"
  },
  "devDependencies": {
    "@ansospace/eslint-config": "workspace:*",
    "@ansospace/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "react": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ansopedia/ansospace"
  },
  "bugs": {
    "url": "https://github.com/ansopedia/ansospace/issues"
  },
  "keywords": [
    "auth",
    "authentication",
    "react-query",
    "ansospace",
    "login",
    "typescript"
  ],
  "license": "MIT"
}
