{
  "name": "@ansospace/ui",
  "version": "0.0.3",
  "type": "module",
  "description": "UI components for Ansospace",
  "author": "Ansospace",
  "license": "MIT",
  "keywords": [
    "ansospace",
    "ui",
    "components",
    "react",
    "next"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc -p tsconfig.lint.json --noEmit",
    "build": "tsup",
    "publish-packages": "turbo run build lint && changeset version && changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.577.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.4",
    "react-resizable-panels": "4.10.0",
    "recharts": "3.8.0",
    "shadcn": "4.2.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "3.25.76"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ansospace/eslint-config": "workspace:*",
    "@ansospace/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "tailwindcss": "4.1.18",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./globals.css": "./dist/styles/globals.css",
    "./postcss.config": "./dist/postcss.config.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "package.json",
    "CHANGELOG.md"
  ]
}
