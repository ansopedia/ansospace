{
  "name": "ansospace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\"",
    "prepare": "husky",
    "publish-packages": "turbo run build --filter=@ansospace/types && changeset publish"
  },
  "devDependencies": {
    "@ansospace/eslint-config": "workspace:*",
    "@ansospace/typescript-config": "workspace:*",
    "@changesets/cli": "^2.29.8",
    "@trivago/prettier-plugin-sort-imports": "6.0.0",
    "husky": "9.1.7",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "2.7.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24"
  }
}
